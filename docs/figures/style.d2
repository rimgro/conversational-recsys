# Общие стили схем twotower. Подключается в начале схемы строкой `...@style`.
# Цвета меняются только здесь.

vars: {
  d2-config: {
    layout-engine: elk
    pad: 20
  }
}

classes: {
  input: {
    style: {fill: "#ffffff"; stroke: "#9a9a9a"; stroke-dash: 3; border-radius: 4; font-size: 18}
  }
  frozen: {
    style: {fill: "#dde8f5"; stroke: "#4a78b5"; border-radius: 4; font-size: 18}
  }
  lora: {
    style: {fill: "#dde8f5"; stroke: "#c0392b"; stroke-width: 3; border-radius: 4; font-size: 18}
  }
  trainable: {
    style: {fill: "#fde3cc"; stroke: "#d9822b"; border-radius: 4; font-size: 18}
  }
  # обучаемая таблица эмбеддингов
  emb: {
    shape: cylinder
    style: {fill: "#fde3cc"; stroke: "#d9822b"; font-size: 18}
  }
  output: {
    style: {fill: "#ffffff"; stroke: "#222222"; stroke-width: 2; bold: true; font-size: 20}
  }
  tower: {
    style: {fill: "#fafafa"; stroke: "#bbbbbb"; border-radius: 8; font-size: 20; bold: true}
  }
  # невидимый ряд grid-раскладки
  row: {
    label: ""
    style: {fill: transparent; stroke: transparent}
  }
  group: {
    style: {fill: "#ffffff"; stroke: "#bbbbbb"; stroke-dash: 4; border-radius: 6; font-size: 16}
  }
}
