# Two-tower v2 (twotower.arch: v2, recsys/twotower/model.py). Описание: docs/arch/twotower_v2.md
# Сборка: make -C docs/figures
# Раскладка — grid: ряды сверху вниз (скор, башни, эмбеддинги, входы), внутри башен — снизу вверх.

...@style

grid-columns: 1
grid-gap: 60

score: "скор = u · v / τ  →  softmax по 64 016 трекам\n(другие записи той же песни — не негативы)" {class: output}

towers: {
  class: row
  grid-columns: 2
  grid-gap: 80

  user: "Башня пользователя" {
    class: tower
    direction: up
    qwen: "Qwen3-Embedding-0.6B\n28 слоёв, hidden 1024" {class: lora}
    sc: "короткий путь:\nattention q(h) → треки истории\nключи k(r_j), значения v_j\n+ пустой слот" {class: trainable}
    proj: "Linear 1024→256" {class: trainable}
    head: "u = L2( Linear(h) + α · прочитанное )" {class: trainable}
    qwen -> proj: "h_EOS [1024]"
    qwen -> sc: "h_EOS"
    proj -> head
    sc -> head
  }

  item: "Башня трека" {
    class: tower
    direction: up
    code: "среднее 4 строк\n→ Linear 1024→256 → LN" {class: trainable}
    tag: "LN" {class: trainable}
    mlp: "MLP 512→512→256 = r_j" {class: trainable}
    head: "Linear 256→256 → L2 = v_j" {class: trainable}
    code -> mlp
    tag -> mlp
    mlp -> head
  }
}

embs: {
  class: row
  grid-columns: 2
  grid-gap: 80
  txt: "эмбеддер текста Qwen" {class: frozen}
  shared: "общие для обеих башен" {
    class: group
    grid-columns: 2
    grid-gap: 30
    E: "таблица кодов\n777 × 1024\n(старт: P·центроид)" {class: emb}
    T: "таблица тегов\n~12.5k × 256" {class: emb}
  }
}

inputs: {
  class: row
  grid-columns: 3
  grid-gap: 60
  query: "Instruct … Request: <запрос> <EOS>" {class: input}
  hist: "история: 64 трека × 4 токена кода\n(+ Linear(теги) к каждому)" {class: input}
  track: "трек-кандидат:\n4 кода + теги" {class: input}
}

inputs.query -> embs.txt
inputs.hist -> embs.shared
inputs.track -> embs.shared
embs.txt -> towers.user.qwen
embs.shared.E -> towers.user.qwen: "токены треков [1024]"
embs.shared.E -> towers.item.code
embs.shared.T -> towers.item.tag
towers.item.mlp -> towers.user.sc: "r_j, v_j" {style.stroke-dash: 4}

towers.user.head -> score: "u [256]"
towers.item.head -> score: "v [256]"

legend: @legend
