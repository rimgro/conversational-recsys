# Lazy two-tower (twotower.arch: lazy, mode: encdec; ветка dev/lazy, recsys/twotower/lazy.py).
# Описание: docs/arch/twotower_lazy.md. Сборка: make -C docs/figures
# Раскладка — grid: ряды сверху вниз (скор, башни, эмбеддинги, входы), внутри башен — снизу вверх.

...@style

grid-columns: 1
grid-gap: 60

score: "скор = u · v / τ  →  softmax по 64 016 трекам" {class: output}

towers: {
  class: row
  grid-columns: 2
  grid-gap: 80

  user: "Башня пользователя" {
    class: tower
    grid-columns: 1
    grid-gap: 40
    head: "u = L2(Linear 1024→256 (h_EOS))" {class: trainable}
    body: {
      class: row
      grid-columns: 2
      grid-gap: 70
      enc: "1. энкодер истории\nE копий слоёв Qwen (E = 0, 2, 4)\nattention в обе стороны\n→ память M = [пустой слот; история]\n(1 + 256) × 1024\nзависит только от пользователя" {class: trainable}
      dec: "2. декодер × 28 — только текст запроса" {
        class: group
        direction: up
        xattn: "x += tanh(g_l) · CrossAttn(x → M)\nкопия q/k/v/o слоя l, g_l = 0 на старте" {class: trainable}
        layer: "слой Qwen l\nself-attn по тексту + MLP" {class: lora}
        xattn -> layer
      }
      enc -> dec.xattn: "k, v ← M"
    }
    body.dec -> head: "h_EOS [1024]"
  }

  item: "Башня трека" {
    class: tower
    direction: up
    title: "Linear 1024→256 → LN" {class: trainable}
    tag: "LN" {class: trainable}
    code: "склейка 4 × 32 → MLP → 256 → LN" {class: trainable}
    mlp: "MLP 768→512→256 = r_j" {class: trainable}
    head: "Linear 256→256 → L2 = v_j" {class: trainable}
    code -> mlp
    tag -> mlp
    title -> mlp
    mlp -> head
  }
}

embs: {
  class: row
  grid-columns: 3
  grid-gap: 50
  hemb: "токен трека = LN( Linear(r_j из башни трека)\n+ E_pos[свежесть] + E_count[log₂ прослуш.]\n+ E_age[log₂ дней] )  [1024]" {class: emb}
  txt: "эмбеддер текста Qwen" {class: frozen}
  track: "трек" {
    class: group
    grid-columns: 3
    grid-gap: 20
    title: "название:\nQwen3-Emb [1024]\n(заранее)" {class: frozen}
    T: "теги\n~12.5k × 256" {class: emb}
    E: "коды RQ-VAE\n777 × 32" {class: emb}
  }
}

inputs: {
  class: row
  grid-columns: 3
  grid-gap: 60
  hist: "история: 256 треков по exp(−давность/180 дн)\n1 трек = 1 токен" {class: input}
  query: "Instruct … Query: <запрос> <EOS>\n(~34 токена)" {class: input}
  track: "трек-кандидат" {class: input}
}

inputs.query -> embs.txt
inputs.hist -> embs.hemb
inputs.track -> embs.track
embs.txt -> towers.user.body.dec.xattn: "текст запроса"
embs.hemb -> towers.user.body.enc
embs.track.E -> towers.item.code
embs.track.T -> towers.item.tag
embs.track.title -> towers.item.title

towers.user.head -> score: "u [256]"
towers.item.head -> score: "v [256]"

legend: @legend
